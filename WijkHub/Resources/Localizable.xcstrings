    "Deleting your account permanently removes your profile, messages, comments and photos.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je je account verwijdert, worden je profiel, berichten, reacties en foto's definitief gewist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Löschen deines Kontos werden Profil, Beiträge, Kommentare und Fotos endgültig entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de votre compte efface définitivement votre profil, vos messages, commentaires et photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar tu cuenta se borran definitivamente tu perfil, mensajes, comentarios y fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminando l'account verranno rimossi definitivamente profilo, messaggi, commenti e foto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du raderar kontot tas din profil, dina inlägg, kommentarer och foton bort permanent."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du sletter kontoen, fjernes profil, innlegg, kommentarer og bilder permanent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du sletter din konto, fjernes din profil, dine opslag, kommentarer og fotos permanent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie konta trwale usuwa profil, wiadomości, komentarze i zdjęcia."
          }
        }
      }
    },
