    "Suspicious situation without danger: call the police on 0900-8844. Then warn your neighbours here.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdachte situatie zonder direct gevaar: bel de politie via 0900-8844. Waarschuw daarna hier je buren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdächtige Situation ohne Gefahr: Ruf die Polizei unter 0900-8844 an. Warne dann hier deine Nachbarn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Situation suspecte sans danger : appelez la police au 0900-8844. Prévenez ensuite vos voisins ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Situación sospechosa sin peligro: llama a la policía al 0900-8844. Después avisa aquí a tus vecinos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Situazione sospetta senza pericolo: chiama la polizia allo 0900-8844. Poi avvisa qui i tuoi vicini."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Misstänkt situation utan fara: ring polisen på 0900-8844. Varna sedan dina grannar här."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistenkelig situasjon uten fare: ring politiet på 0900-8844. Varsle deretter naboene her."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistænkelig situation uden fare: ring til politiet på 0900-8844. Advar derefter dine naboer her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podejrzana sytuacja bez zagrożenia: zadzwoń na policję pod 0900-8844. Potem ostrzeż tu sąsiadów."
          }
        }
      }
    },
