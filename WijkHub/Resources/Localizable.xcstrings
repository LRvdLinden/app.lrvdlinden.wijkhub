    "Only neighbours in your own neighbourhood can see your number, and only if you switch this on.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen buren in je eigen wijk zien je nummer, en alleen als je dit aanzet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Nachbarn in deinem Viertel sehen deine Nummer, und nur wenn du das einschaltest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les voisins de votre quartier voient votre numéro, et uniquement si vous l'activez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los vecinos de tu barrio ven tu número, y solo si lo activas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i vicini del tuo quartiere vedono il tuo numero, e solo se lo attivi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara grannar i ditt grannskap ser ditt nummer, och bara om du slår på det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare naboer i ditt nabolag ser nummeret ditt, og bare hvis du slår dette på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun naboer i dit kvarter kan se dit nummer, og kun hvis du slår det til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój numer widzą tylko sąsiedzi z twojej okolicy i tylko po włączeniu tej opcji."
          }
        }
      }
    },
