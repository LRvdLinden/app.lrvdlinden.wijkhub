    "No neighbourhood found. Ask your neighbourhood council to add it.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen wijk gevonden. Vraag je wijkraad om hem toe te voegen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Viertel gefunden. Bitte deinen Quartiersrat, es hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun quartier trouvé. Demandez à votre conseil de quartier de l'ajouter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún barrio. Pide a tu asociación vecinal que lo añada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun quartiere trovato. Chiedi al tuo consiglio di quartiere di aggiungerlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget grannskap hittades. Be ditt grannskapsråd att lägga till det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ikke nabolaget. Be nabolagsrådet legge det til."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet kvarter fundet. Bed dit kvarterråd om at tilføje det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono okolicy. Poproś radę osiedla o jej dodanie."
