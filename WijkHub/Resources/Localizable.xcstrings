    "WijkHub is for and by neighbours. That only works if we treat each other well.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WijkHub is van en voor buren. Dat werkt alleen als we goed met elkaar omgaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WijkHub ist von und für Nachbarn. Das funktioniert nur, wenn wir gut miteinander umgehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WijkHub est fait par et pour les voisins. Cela ne fonctionne que si nous nous respectons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "WijkHub es de y para los vecinos. Solo funciona si nos tratamos bien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WijkHub è dei vicini e per i vicini. Funziona solo se ci trattiamo bene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "WijkHub är av och för grannar. Det fungerar bara om vi behandlar varandra väl."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "WijkHub er av og for naboer. Det fungerer bare hvis vi behandler hverandre godt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "WijkHub er af og for naboer. Det virker kun, hvis vi behandler hinanden godt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "WijkHub jest tworzony przez sąsiadów dla sąsiadów. Działa tylko, gdy dobrze się traktujemy."
          }
        }
      }
    },
