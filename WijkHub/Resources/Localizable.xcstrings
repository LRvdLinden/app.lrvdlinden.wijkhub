    "The administrators of your neighbourhood will look at your report. The person you report will not see who reported it.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beheerders van je wijk bekijken je melding. Degene die je meldt, ziet niet wie hem heeft gemeld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verwaltung deines Viertels prüft deine Meldung. Die gemeldete Person sieht nicht, wer sie gemeldet hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les administrateurs de votre quartier examineront votre signalement. La personne signalée ne saura pas qui l'a signalée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los administradores de tu barrio revisarán tu denuncia. La persona denunciada no verá quién la denunció."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli amministratori del quartiere esamineranno la segnalazione. La persona segnalata non saprà chi l'ha segnalata."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratörerna i ditt grannskap tittar på anmälan. Personen du anmäler ser inte vem som anmälde."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorene i nabolaget ser på rapporten. Personen du rapporterer, ser ikke hvem som rapporterte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorerne i dit kvarter ser på din anmeldelse. Den anmeldte kan ikke se, hvem der anmeldte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorzy okolicy sprawdzą zgłoszenie. Zgłoszona osoba nie zobaczy, kto ją zgłosił."
          }
        }
      }
    },
