    "Be friendly and respectful, also when you disagree.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wees vriendelijk en respectvol, ook als je het oneens bent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei freundlich und respektvoll, auch wenn du anderer Meinung bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez aimable et respectueux, même en cas de désaccord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé amable y respetuoso, también cuando no estés de acuerdo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sii gentile e rispettoso, anche quando non sei d'accordo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var vänlig och respektfull, även när ni inte håller med varandra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær vennlig og respektfull, også når dere er uenige."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær venlig og respektfuld, også når I er uenige."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bądź życzliwy i pełen szacunku, także gdy się nie zgadzasz."
          }
        }
      }
    },
