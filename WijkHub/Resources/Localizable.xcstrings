    "Need a hand, or happy to help? Post it here.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hulp nodig, of help je graag? Zet het hier neer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brauchst du Hilfe oder hilfst du gern? Poste es hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besoin d'un coup de main ou envie d'aider ? Publiez-le ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Necesitas una mano o te gusta ayudar? Publícalo aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti serve una mano o ti piace aiutare? Pubblicalo qui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behöver du hjälp eller vill du hjälpa till? Lägg upp det här."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenger du hjelp, eller vil du hjelpe? Legg det ut her."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug for hjælp, eller vil du gerne hjælpe? Skriv det her."
