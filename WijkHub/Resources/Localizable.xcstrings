    "Report messages that break the rules. The administrators can remove them and block people.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld berichten die de regels overtreden. De beheerders kunnen ze verwijderen en mensen blokkeren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde Beiträge, die gegen die Regeln verstoßen. Die Verwaltung kann sie entfernen und Personen sperren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalez les messages qui enfreignent les règles. Les administrateurs peuvent les supprimer et bloquer des personnes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Denuncia los mensajes que incumplan las normas. Los administradores pueden eliminarlos y bloquear a personas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnala i messaggi che violano le regole. Gli amministratori possono rimuoverli e bloccare persone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmäl inlägg som bryter mot reglerna. Administratörerna kan ta bort dem och blockera personer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporter innlegg som bryter reglene. Administratorene kan fjerne dem og blokkere personer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeld opslag, der bryder reglerne. Administratorerne kan fjerne dem og blokere personer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłaszaj wiadomości łamiące zasady. Administratorzy mogą je usuwać i blokować osoby."
          }
        }
      }
    },
