    "In an emergency, always call 112 first. WijkHub is not an emergency service.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij nood altijd eerst 112 bellen. WijkHub is geen alarmdienst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Notfall immer zuerst 112 anrufen. WijkHub ist kein Notdienst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas d'urgence, appelez toujours d'abord le 112. WijkHub n'est pas un service d'urgence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En caso de emergencia, llama siempre primero al 112. WijkHub no es un servicio de emergencias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In caso di emergenza chiama sempre prima il 112. WijkHub non è un servizio di emergenza."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid nödläge, ring alltid 112 först. WijkHub är ingen larmtjänst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved nødsituasjoner, ring alltid 112 først. WijkHub er ingen nødtjeneste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved nødsituationer skal du altid ringe 112 først. WijkHub er ikke en alarmtjeneste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W nagłym wypadku zawsze najpierw dzwoń pod 112. WijkHub nie jest służbą ratunkową."
