    "Neighbours can see the status. Sold and given-away items are hidden in the market unless someone chooses to show them.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buren zien de status. Verkochte en weggegeven spullen worden in de markt verborgen, tenzij iemand ze wil zien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachbarn sehen den Status. Verkaufte und verschenkte Artikel sind im Markt ausgeblendet, außer man blendet sie ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voisins voient le statut. Les objets vendus ou donnés sont masqués sauf si quelqu'un choisit de les afficher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vecinos ven el estado. Los artículos vendidos o regalados se ocultan salvo que alguien elija mostrarlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I vicini vedono lo stato. Gli oggetti venduti o regalati sono nascosti, a meno che qualcuno scelga di mostrarli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Grannar ser statusen. Sålda och bortskänkta saker döljs på marknaden om man inte väljer att visa dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Naboer ser statusen. Solgte og bortgitte ting skjules på markedet med mindre noen velger å vise dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Naboer kan se status. Solgte og bortgivne ting skjules på markedet, medmindre man vælger at vise dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sąsiedzi widzą status. Sprzedane i oddane rzeczy są ukryte, chyba że ktoś zechce je pokazać."
          }
        }
      }
    },
